NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# Set the trusted reverse-proxy hop count; use 0 when there is no proxy.
TRUST_PROXY=0
PUBLIC_ORIGIN=https://admin.example.com
# Must be an absolute path on persistent storage in production.
DATABASE_PATH=/var/lib/cds/admin.db
# Generate a unique value of at least 32 bytes and inject it in the host.
SESSION_SECRET=
GITHUB_TOKEN=
# Fine-grained PAT: Contents Read and write + Actions Read-only.
GITHUB_REPOSITORY=cdssistemas10-design/cdssistemas10-design.github.io
GITHUB_BRANCH=main
